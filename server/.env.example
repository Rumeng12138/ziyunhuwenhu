# 服务端口
PORT=3000
NODE_ENV=development

# JWT 密钥（生产环境请更换为复杂随机字符串）
JWT_SECRET=ziyunhu_wenfang_secret_key_2026

# 新数据库在生产环境首次启动时必填；至少12位且包含字母和数字。初始化成功后从部署平台删除
ADMIN_INITIAL_PASSWORD=

# JWT 过期时间
JWT_EXPIRES_IN=7d

# 统一持久化目录。Render 付费磁盘建议挂载到 /var/data 并设置 STORAGE_DIR=/var/data
STORAGE_DIR=

# 可选：单独覆盖数据库、上传和备份目录；留空时均从 STORAGE_DIR 派生
DB_PATH=
UPLOAD_DIR=
BACKUP_DIR=
PAYMENT_SETTINGS_DIR=

# 前端域名（用于 CORS，多个用逗号分隔）
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# 生产站点公网 HTTPS 地址（用于 sitemap 与上线检查，不要带末尾 /）
PUBLIC_SITE_URL=https://shop.example.com

# 位于 Nginx 等可信单层反向代理后时设为 true；没有代理时留空
TRUST_PROXY=

# 前后端分离时允许前端请求的 API 地址；同源部署留空
CSP_CONNECT_SRC=

# 中国大陆网站需要强制备案号才能发布经营资料时设为 1
REQUIRE_ICP=0

# 对接平台时再填写
PLATFORM_TAOBAO_MAIN=
PLATFORM_TMALL_MAIN=
PLATFORM_DOUYIN_MAIN=
PLATFORM_WECHAT_MAIN=
